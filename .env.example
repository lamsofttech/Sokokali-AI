# Copy to .env (repository root or backend/) and adjust. Never commit .env.
# All variables are optional; the defaults below are used when unset.

SOKOKALI_ENVIRONMENT=development
SOKOKALI_LOG_LEVEL=INFO
# true = one JSON object per log line; false = human-readable lines
SOKOKALI_LOG_JSON=true

# JSON list of browser origins allowed to call the API
SOKOKALI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Sports data provider: simulated (offline, default) or football_data (real data from football-data.org)
SOKOKALI_SPORTS_PROVIDER=simulated
SOKOKALI_SIMULATION_SEED=2024
# Free key from https://www.football-data.org/client/register - keep it only in .env
FOOTBALL_DATA_API_KEY=
# JSON list of competition codes (PL = Premier League). The free tier is rate-limited: keep this short.
SOKOKALI_FOOTBALL_DATA_COMPETITIONS=["PL"]
# Seasons downloaded for model history (current + previous = 2)
SOKOKALI_FOOTBALL_DATA_SEASONS_OF_HISTORY=2
# How long downloaded data is reused before refreshing (seconds)
SOKOKALI_SPORTS_CACHE_TTL_SECONDS=300
SOKOKALI_HTTP_TIMEOUT_SECONDS=10
SOKOKALI_HTTP_MAX_ATTEMPTS=3

# Prediction model
SOKOKALI_PREDICTION_MODEL_VERSION=poisson-elo-blend-0.1.0
SOKOKALI_PREDICTION_POISSON_WEIGHT=0.7
SOKOKALI_PREDICTION_MIN_HISTORY_MATCHES=10

# Forex. Only "simulated" exists so far.
SOKOKALI_FOREX_ENABLED=true
SOKOKALI_FOREX_PROVIDER=simulated
SOKOKALI_FOREX_SIGNAL_MODEL_VERSION=fx-technical-0.1.0
# Publishing entry/stop-loss/take-profit levels to the public may be regulated investment advice
# (in Kenya, the Capital Markets Authority licenses investment advisers). Keep false until a
# licensing/legal review approves it.
SOKOKALI_FOREX_TRADE_LEVELS_ENABLED=false

# Conversational AI (Anthropic Claude)
# auto = use Claude when ANTHROPIC_API_KEY is set, otherwise the offline rule-based engine
# anthropic = always use Claude; none = rule-based engine only
SOKOKALI_LLM_PROVIDER=auto
# Your key from https://console.anthropic.com/ - keep it only in .env, never commit it
ANTHROPIC_API_KEY=
SOKOKALI_LLM_MODEL=claude-opus-5-5
# low keeps livestream replies fast; medium/high think more (slower, costlier)
SOKOKALI_LLM_EFFORT=low
SOKOKALI_LLM_MAX_TOKENS=16000
SOKOKALI_LLM_TIMEOUT_SECONDS=30
SOKOKALI_LLM_MAX_RETRIES=2
SOKOKALI_LLM_MAX_TOOL_ROUNDS=4
# Earlier chat turns (per viewer) sent to Claude as context
SOKOKALI_LLM_HISTORY_TURNS=6

# Persistence. Docker Compose sets these two automatically (PostgreSQL + Redis containers).
# Leave empty when running without Docker: Sokokali then keeps everything in memory.
SOKOKALI_DATABASE_URL=
SOKOKALI_REDIS_URL=
# How often engagement state (points, milestones) is saved during a broadcast
SOKOKALI_GAMIFICATION_SNAPSHOT_SECONDS=30
# Password for the local PostgreSQL container (set before the first `docker compose up`)
POSTGRES_PASSWORD=sokokali-local-only

# Admin token for broadcast controls and the live feed. Optional in development (controls are open);
# REQUIRED in staging/production, where admin endpoints refuse all requests until it is set.
# Use a long random value, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(32))"
SOKOKALI_ADMIN_TOKEN=

# Livestream: simulated (local audience) or tiktok (refuses to start until authorized access exists)
SOKOKALI_LIVE_SOURCE=simulated
SOKOKALI_LIVE_SIM_EVENTS_PER_SECOND=0.6
SOKOKALI_LIVE_MAX_QUEUE=50
SOKOKALI_LIVE_DEDUP_TTL_SECONDS=60
SOKOKALI_LIVE_COMMENTS_PER_VIEWER_PER_MINUTE=4
# Questions older than this are skipped instead of answered late
SOKOKALI_LIVE_MAX_COMMENT_AGE_SECONDS=90
# Speaking pace used to avoid overlapping replies
SOKOKALI_LIVE_WORDS_PER_SECOND=2.6
SOKOKALI_LIVE_MIN_GAP_SECONDS=2
# Segments (match preview, trivia, forex, poll, responsible gambling): after this much quiet...
SOKOKALI_LIVE_SEGMENT_INTERVAL_SECONDS=45
# ...and at least this often even when chat is busy
SOKOKALI_LIVE_SEGMENT_MAX_GAP_SECONDS=180
SOKOKALI_LIVE_TRIVIA_SECONDS=30
SOKOKALI_LIVE_POLL_SECONDS=45

# Responsible-gambling reminders
SOKOKALI_COMPLIANCE_JURISDICTION=KE
SOKOKALI_COMPLIANCE_MIN_AGE=18

# Chat
SOKOKALI_CHAT_MAX_MESSAGE_LENGTH=500
SOKOKALI_CONVERSATION_HISTORY_TURNS=10
SOKOKALI_CONVERSATION_TTL_SECONDS=1800
SOKOKALI_CHAT_RATE_LIMIT_PER_MINUTE=30
